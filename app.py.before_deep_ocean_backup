def make_gis_map(frame, height=570):
    """Create risk-coloured GIS points with useful hover labels."""
    plot_df = frame.copy()
    plot_df[lat_col] = pd.to_numeric(plot_df[lat_col], errors="coerce")
    plot_df[lon_col] = pd.to_numeric(plot_df[lon_col], errors="coerce")
    plot_df["_prediction"] = pd.to_numeric(plot_df["_prediction"], errors="coerce")
    plot_df = plot_df.dropna(subset=[lat_col, lon_col])
    hover_cols = ["_place_label", "_risk"]
    if "_prediction" in plot_df.columns:
        hover_cols.append("_prediction")
    if actual_col and actual_col in plot_df.columns and actual_col not in hover_cols:
        hover_cols.append(actual_col)
    hover_cols = [c for c in hover_cols if c in plot_df.columns]
    fig = px.scatter_mapbox(
        plot_df, lat=lat_col, lon=lon_col, color="_risk",
        color_discrete_map=RISK_COLORS, hover_name="_place_label",
        hover_data={c: True for c in hover_cols if c != "_place_label"},
        custom_data=["_place_label", "_risk", "_prediction"],
        zoom=1, height=height, mapbox_style="carto-darkmatter",
        category_orders={"_risk": ["Low", "Moderate", "High", "Critical", "Unclassified"]}
    )
    fig.update_traces(marker={"size": 12, "opacity": 0.9})
    fig.update_layout(
        paper_bgcolor="rgba(0,0,0,0)", font_color="#eafaff",
        margin=dict(l=0, r=0, t=5, b=0), legend_title_text="Pollution risk",
        clickmode="event+select"
    )
    return fig, plot_df

def show_selected_location(chart_event, plot_df):
    """Display selected point details when the user clicks a map marker."""
    selected_index = None
    try:
        selection = chart_event.selection
        points = selection.get("points", []) if isinstance(selection, dict) else getattr(selection, "points", [])
        if points:
            point = points[0]
            selected_index = point.get("point_index", point.get("pointIndex")) if isinstance(point, dict) else getattr(point, "point_index", None)
    except Exception:
        selected_index = None
    if selected_index is None:
        st.caption("Tip: click a coloured dot on the map to see that location's details below. Hover also shows its label.")
        return
    try:
        row = plot_df.iloc[int(selected_index)]
    except Exception:
        return
    st.markdown("#### 📍 Selected location details")
    a, b, c = st.columns(3)
    a.metric("Place / location", str(row.get("_place_label", "Unknown")))
    b.metric("Predicted pollution", f"{float(row['_prediction']):,.3f}" if pd.notna(row.get("_prediction")) else "Unavailable")
    c.metric("Risk level", str(row.get("_risk", "Unclassified")))
    if lat_col and lon_col:
        st.caption(f"Coordinates: {float(row[lat_col]):.5f}, {float(row[lon_col]):.5f}")


