def normalize_risk(value):
    value = str(value).strip().lower()

    if "critical" in value or "very high" in value:
        return "Critical"
    if "high" in value:
        return "High"
    if "moderate" in value or "medium" in value:
        return "Moderate"
    if "low" in value:
        return "Low"

    return "Unclassified"


