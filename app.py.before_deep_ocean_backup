}


# ---------- STANDARDIZE GIS DATA ----------
lat_col = find_lat_col(gis_df)
lon_col = find_lon_col(gis_df)
pred_col = find_prediction_col(gis_df)
actual_col = find_target_col(gis_df)
risk_col = find_risk_col(gis_df)

if not gis_df.empty:
    source_col = pred_col or actual_col

    if source_col:
        gis_df["_prediction"] = pd.to_numeric(
            gis_df[source_col], errors="coerce"
        )
    else:
        gis_df["_prediction"] = np.nan

    if risk_col:
        gis_df["_risk"] = gis_df[risk_col].map(normalize_risk)

    elif gis_df["_prediction"].notna().sum() >= 4:
        ranks = gis_df["_prediction"].rank(
            method="average", pct=True
        )

        gis_df["_risk"] = np.select(
            [
                ranks <= .25,
                ranks <= .50,
                ranks <= .75,
                ranks > .75
            ],
            ["Low", "Moderate", "High", "Critical"],
            default="Unclassified"
        )

    else:
        gis_df["_risk"] = "Unclassified"


def first_numeric_from_frames(frames, col_finder):
    for frame in frames:
        if frame is not None and not frame.empty:
            col = col_finder(frame)
            values = numeric_values(frame, col)

            if len(values):
                return values

    return pd.Series(dtype=float)


prediction_values = (
    numeric_values(gis_df, "_prediction")
    if not gis_df.empty
    else pd.Series(dtype=float)
)

